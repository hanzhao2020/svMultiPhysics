<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="0.1">

<GeneralSimulationParameters>

  <Continue_previous_simulation> false </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 2 </Number_of_spatial_dimensions> 
  <Number_of_time_steps> 3 </Number_of_time_steps> 
  <Time_step_size> 1e-4 </Time_step_size> 
  <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step> 
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop> 

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format> 
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 3 </Increment_in_saving_VTK_files> 
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step> 

  <Increment_in_saving_restart_files> 100 </Increment_in_saving_restart_files> 
  <Convert_BIN_to_VTK_format> 0 </Convert_BIN_to_VTK_format> 

  <Verbose> 1 </Verbose> 
  <Warning> 0 </Warning> 
  <Debug> 0 </Debug> 

</GeneralSimulationParameters>


<Add_mesh name="fluid" > 
  <Mesh_file_path> mesh/fluid-mesh/mesh-complete.mesh.vtu </Mesh_file_path>
  <Add_face name="fluid_left">
      <Face_file_path> mesh/fluid-mesh/mesh-surfaces/left.vtp </Face_file_path>
  </Add_face>
  <Add_face name="fluid_bottom">
      <Face_file_path> mesh/fluid-mesh/mesh-surfaces/bottom.vtp </Face_file_path>
  </Add_face>
  <Add_face name="fluid_top">
      <Face_file_path> mesh/fluid-mesh/mesh-surfaces/top.vtp </Face_file_path>
  </Add_face>
  <Add_face name="fluid_right">
      <Face_file_path> mesh/fluid-mesh/mesh-surfaces/right.vtp </Face_file_path>
  </Add_face>
  <Domain> 0 </Domain>
</Add_mesh>

<Add_mesh name="solid" > 
  <Mesh_file_path> mesh/solid-mesh/mesh-complete.mesh.vtu </Mesh_file_path>
  <Add_face name="solid_left">
      <Face_file_path> mesh/solid-mesh/mesh-surfaces/left.vtp </Face_file_path>
  </Add_face>
  <Add_face name="solid_right">
      <Face_file_path> mesh/solid-mesh/mesh-surfaces/right.vtp </Face_file_path>
  </Add_face>
  <Add_face name="solid_bottom">
      <Face_file_path> mesh/solid-mesh/mesh-surfaces/bottom.vtp </Face_file_path>
  </Add_face>
  <Add_face name="solid_top">
      <Face_file_path> mesh/solid-mesh/mesh-surfaces/top.vtp </Face_file_path>
  </Add_face>
  <Domain> 1 </Domain>
</Add_mesh>

<Add_equation type="immersed_FSI" > 
   <Coupled> true </Coupled>
   <Min_iterations> 3 </Min_iterations>  
   <Max_iterations> 10 </Max_iterations> 
   <Tolerance> 1e-4 </Tolerance> 
   
  <Immersed_method type="IFEM">
    <Background_fluid_domain> 0 </Background_fluid_domain>
    <Immersed_solid_domain> 1 </Immersed_solid_domain>
    <Coupling_method type="monolithic"> </Coupling_method>
    <Interpolation type="FE"> </Interpolation>
    <VMS_stabilization_s> 100.0 </VMS_stabilization_s>
    <VMS_stabilization_width> 1.0 </VMS_stabilization_width>
  </Immersed_method>

   <Domain id="0" >
      <Equation> fluid </Equation> 
      <Density> 1.06 </Density> 
      <Viscosity model="Constant" >
         <Value> 0.04 </Value>
      </Viscosity>
      <Backflow_stabilization_coefficient> 0.2 </Backflow_stabilization_coefficient> 
   </Domain>
   
   <Domain id="1" >
      <Equation> struct </Equation> 
      <Constitutive_model type="neoHookean"> </Constitutive_model> 
      <Dilational_penalty_model> M94 </Dilational_penalty_model> 
      <Density> 1.0 </Density> 
      <Elasticity_modulus> 5e5 </Elasticity_modulus> 
      <Poisson_ratio> 0.3 </Poisson_ratio> 
   </Domain>

  <LS type="GMRES" >
    <Linear_algebra type="fsils" >
      <Preconditioner> fsils </Preconditioner>
    </Linear_algebra>
    <Tolerance> 1e-4 </Tolerance>
    <Absolute_tolerance> 1e-5 </Absolute_tolerance>
    <Max_iterations> 5000 </Max_iterations> 
    <Krylov_space_dimension> 100 </Krylov_space_dimension>
  </LS>

   <Output type="Spatial" >
     <Displacement> true </Displacement>
     <Velocity> true </Velocity>
     <Pressure> true </Pressure>
     <VonMises_stress> true </VonMises_stress>
   </Output>

   <Output type="B_INT" >
     <Pressure> true </Pressure>
     <Velocity> true </Velocity>
   </Output>

   <Output type="V_INT" >
     <Pressure> true </Pressure>
   </Output>


   <Add_BC name="fluid_left" > 
      <Type> Dir </Type> 
      <Time_dependence> Unsteady </Time_dependence> 
     <Temporal_values_file_path> lumen_inlet.flow </Temporal_values_file_path> 
      <Profile> Parabolic </Profile> 
      <Impose_flux> true </Impose_flux> 
   </Add_BC> 

   <Add_BC name="fluid_right" > 
      <Type> Neu </Type> 
      <Time_dependence> RCR </Time_dependence> 
      <RCR_values> 
        <Capacitance> 1.5e-5 </Capacitance> 
        <Distal_resistance> 1212 </Distal_resistance> 
        <Proximal_resistance> 121 </Proximal_resistance> 
        <Distal_pressure> 0 </Distal_pressure> 
        <Initial_pressure> 0 </Initial_pressure> 
      </RCR_values> 
   </Add_BC> 

   <Add_BC name="fluid_bottom" > 
      <Type> Dir </Type> 
      <Value> 0.0 </Value> 
   </Add_BC> 

   <Add_BC name="fluid_top" > 
      <Type> Dir </Type> 
      <Value> 0.0 </Value>
   </Add_BC> 

   <Add_BC name="solid_bottom" > 
      <Type> Dirichlet </Type> 
      <Value> 0.0 </Value>
   </Add_BC> 

</Add_equation>

</svMultiPhysicsFile>
